{
  "name": "myseizures",
  "version": "0.1.0",
  "private": true,
  "description": "Academic offline-first epilepsy care prototype",
  "workspaces": [
    "mobile",
    "api"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "npm run start --workspace mobile",
    "dev:api": "npm run dev --workspace api",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,json}\" \"mobile/**/*.{js,json}\" \"api/**/*.{js,json}\"",
    "format:check": "prettier --check \"*.{js,json}\" \"mobile/**/*.{js,json}\" \"api/**/*.{js,json}\"",
    "test": "npm run test --workspaces --if-present",
    "test:mobile": "npm run test --workspace @myseizures/mobile",
    "test:api": "npm run test --workspace @myseizures/api"
  },
  "dependencies": {
    "react": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  }
}
